# Never commit real credentials or participant data.
PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/moa.sqlite
NODE_ENV=development
# On Render only: set TRUST_RENDER_PROXY=1 (RENDER=true is provided by Render).
# On a self-managed proxy: set its exact IP and overwrite X-Real-IP at the proxy.
# TRUSTED_PROXY_IP=127.0.0.1
# Optional first-start administrator. Only used when no active admin exists.
# Use a unique password of at least 12 characters and remove it after setup.
# INITIAL_ADMIN_USERNAME=operator
# INITIAL_ADMIN_PASSWORD=
